# Copiá este archivo a .env y completá tus valores. NO subas .env a git.

# Usuario y contraseña simples para proteger la página (autenticación
# básica del navegador). Si los dejás vacíos, la página queda ABIERTA
# para cualquiera que tenga la URL.
AUTH_USER=vitul
AUTH_PASS=cambiar-esta-clave

# Tamaño máximo total de subida por conversión, en MB.
MAX_UPLOAD_MB=2048

# Puerto interno en el que escucha el servidor Go (no hace falta tocarlo,
# Caddy lo redirige desde afuera).
PORT=8080
